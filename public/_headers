# Cloudflare Pages headers: security + cache split.
# Prerendered HTML must revalidate (no-cache); hashed Vite assets are immutable.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=86400

/og/*
  Cache-Control: public, max-age=86400

/blog/*
  Cache-Control: public, max-age=86400

/*.webp
  Cache-Control: public, max-age=86400

/*.png
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

# Prerendered HTML must always revalidate: F5 shows the newest deploy,
# never a stale edge-cached copy. (Assets above stay immutable.)
/
  Cache-Control: no-cache
/ko/*
  Cache-Control: no-cache
/en/*
  Cache-Control: no-cache
/ja/*
  Cache-Control: no-cache
/404.html
  Cache-Control: no-cache

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

/ads.txt
  Cache-Control: public, max-age=3600

/manifest.json
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json; charset=utf-8

/sw.js
  Cache-Control: no-cache
