# Copy to .env for local dev. Hosting env vars must be set for production.
# Google Analytics 4 measurement ID (optional — analytics stays dormant without it)
VITE_GA_ID=G-XXXXXXXXXX
# AdSense publisher client (required after AdSense approval; AdSlot shows a
# neutral placeholder without it). Must match public/ads.txt PUB-ID.
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
