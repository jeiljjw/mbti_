[
  {"id":"EI-01","dimension":"EI","direction":1,"text":"大人数と過ごした後はエネルギーが充電された気分になる。"},
  {"id":"EI-02","dimension":"EI","direction":-1,"text":"アイデアを共有する前に、一人でじっくり考えるのが好きだ。"},
  {"id":"EI-03","dimension":"EI","direction":1,"text":"知らない人に自分から話しかける方だ。"},
  {"id":"EI-04","dimension":"EI","direction":-1,"text":"人混みの中に長時間いると疲れてしまう。"},
  {"id":"EI-05","dimension":"EI","direction":1,"text":"考えを口に出しながら整理し、未完成でも共有する方だ。"},
  {"id":"EI-06","dimension":"EI","direction":-1,"text":"集まりでは目立つより背景にいるのを好む。"},
  {"id":"EI-07","dimension":"EI","direction":1,"text":"一人作業より活気あるチームで働くのが好きだ。"},
  {"id":"EI-08","dimension":"EI","direction":-1,"text":"人と会った後は一人の静かな時間が必要だ。"},
  {"id":"EI-09","dimension":"EI","direction":1,"text":"パーティーでは自然と人の中心にいることが多い。"},
  {"id":"EI-10","dimension":"EI","direction":-1,"text":"グループの会話より一対一の会話を好む。"},
  {"id":"EI-11","dimension":"EI","direction":1,"text":"家にいるより友達と会うことで元気が出る。"},
  {"id":"EI-12","dimension":"EI","direction":-1,"text":"知人との世間話の後はぐったりしてしまう。"},
  {"id":"SN-01","dimension":"SN","direction":1,"text":"将来の可能性より目の前の具体的な事実に注目する。"},
  {"id":"SN-02","dimension":"SN","direction":-1,"text":"抽象的なアイデアに思いを巡らせていることが多い。"},
  {"id":"SN-03","dimension":"SN","direction":1,"text":"一般的な概念より具体的で実用的な指示を好む。"},
  {"id":"SN-04","dimension":"SN","direction":-1,"text":"細部より全体の「大きな絵」に関心がある。"},
  {"id":"SN-05","dimension":"SN","direction":1,"text":"抽象的な理論より自分の経験を信頼する。"},
  {"id":"SN-06","dimension":"SN","direction":-1,"text":"過去の振り返りより未来の可能性を想像するのが好きだ。"},
  {"id":"SN-07","dimension":"SN","direction":1,"text":"他人が見落とす細かい点によく気づく。"},
  {"id":"SN-08","dimension":"SN","direction":-1,"text":"事実の裏にある意味やパターンを探そうとする。"},
  {"id":"SN-09","dimension":"SN","direction":1,"text":"未検証の新手法より実証済みの方法を好む。"},
  {"id":"SN-10","dimension":"SN","direction":-1,"text":"新しさのない繰り返し作業にはすぐ飽きてしまう。"},
  {"id":"SN-11","dimension":"SN","direction":1,"text":"出来事を飾らず事実のまま伝える方だ。"},
  {"id":"SN-12","dimension":"SN","direction":-1,"text":"実務の細部より理論を語るのを好む。"},
  {"id":"TF-01","dimension":"TF","direction":1,"text":"重要な決断では感情より論理を優先する。"},
  {"id":"TF-02","dimension":"TF","direction":-1,"text":"他人の物語や感情に深く共感し感動しやすい。"},
  {"id":"TF-03","dimension":"TF","direction":1,"text":"優しさより公平さを大切にしたいと思う。"},
  {"id":"TF-04","dimension":"TF","direction":-1,"text":"議論に勝つことより場の調和を保つことを重んじる。"},
  {"id":"TF-05","dimension":"TF","direction":1,"text":"感情的な場面でも客観性を保つのは容易だ。"},
  {"id":"TF-06","dimension":"TF","direction":-1,"text":"決定が人々の気持ちに与える影響をまず考える。"},
  {"id":"TF-07","dimension":"TF","direction":1,"text":"相手が傷ついても批判は正直であるべきだと思う。"},
  {"id":"TF-08","dimension":"TF","direction":-1,"text":"誰かが心の支えを求めると断るのが難しい。"},
  {"id":"TF-09","dimension":"TF","direction":1,"text":"心ではなく頭で決める方だ。"},
  {"id":"TF-10","dimension":"TF","direction":-1,"text":"自分が正しいと分かっていても衝突は避けがちだ。"},
  {"id":"TF-11","dimension":"TF","direction":1,"text":"優しさより有能さを高く評価する。"},
  {"id":"TF-12","dimension":"TF","direction":-1,"text":"事務的な評価より温かく個人的な言葉を好む。"},
  {"id":"JP-01","dimension":"JP","direction":1,"text":"気分次第より厳密なスケジュールに従うのを好む。"},
  {"id":"JP-02","dimension":"JP","direction":-1,"text":"ギリギリまで選択肢を残しておく方が気が楽だ。"},
  {"id":"JP-03","dimension":"JP","direction":1,"text":"作業スペースをきれいに整理しておくのが好きだ。"},
  {"id":"JP-04","dimension":"JP","direction":-1,"text":"土壇場の予定変更を楽しめる方だ。"},
  {"id":"JP-05","dimension":"JP","direction":1,"text":"明確な計画がないと作業を始めにくい。"},
  {"id":"JP-06","dimension":"JP","direction":-1,"text":"早めの確定より選択肢を開いておくのを好む。"},
  {"id":"JP-07","dimension":"JP","direction":1,"text":"ToDoリストを作り消し込むことに満足を感じる。"},
  {"id":"JP-08","dimension":"JP","direction":-1,"text":"締め切り直前のプレッシャーで実力を発揮する。"},
  {"id":"JP-09","dimension":"JP","direction":1,"text":"締め切りよりずっと早めに仕事を終えるのを好む。"},
  {"id":"JP-10","dimension":"JP","direction":-1,"text":"厳格なルーティンは退屈で窮屈に感じる。"},
  {"id":"JP-11","dimension":"JP","direction":1,"text":"予定が土壇場で変わると落ち着かない。"},
  {"id":"JP-12","dimension":"JP","direction":-1,"text":"決まった手順よりその場のアドリブを好む。"}
]
